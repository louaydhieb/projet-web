# ─────────────────────────────────────────────
# Variables d'environnement – NE JAMAIS COMMITER CE FICHIER
# Copiez ce fichier vers .env et remplissez les valeurs
# ─────────────────────────────────────────────

# Clé secrète Flask (génération : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGEZ_MOI_FLASK_SECRET

# Clé de chiffrement AES-256 (32 octets encodés en base64 URL-safe)
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_ENCRYPTION_KEY=CHANGEZ_MOI_FERNET_KEY

# Clé secrète HMAC (différente de AES)
# Génération : python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=CHANGEZ_MOI_HMAC_SECRET

# URI de la base de données SQLite
DATABASE_URL=sqlite:///secure_app.db

# Mode de l'application : development | production
FLASK_ENV=development

# Durée de session (en secondes) – 30 minutes par défaut
SESSION_LIFETIME=1800

# Nombre maximum de tentatives de connexion par IP
LOGIN_RATE_LIMIT=5 per 10 minutes
